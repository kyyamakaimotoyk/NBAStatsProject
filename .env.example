# Copy this file to .env and fill in your real values.
# .env is gitignored; .env.example is committed as a template.

NBA_DB_HOST=localhost
NBA_DB_PORT=3306
NBA_DB_USER=your_mysql_username
NBA_DB_PASSWORD=your_mysql_password
NBA_DB_NAME=nba_data

# ---------------------------------------------------------------------------
# Model artifact store (see core/artifact_store.py)
# ---------------------------------------------------------------------------
# Leave BOTH unset for pure-local development (models/ on local disk only).
#
# Production (S3): set the bucket; AWS creds come from the standard chain
# (env vars, ~/.aws/credentials, or the task's IAM role on Fargate).
# MODELS_S3_BUCKET=nba-models-123456789012
# MODELS_S3_PREFIX=prod
#
# Local testing of the push/pull flow without AWS: point at a scratch dir that
# stands in for the bucket.
# MODELS_ARTIFACT_DIR=.artifact_store_mirror
