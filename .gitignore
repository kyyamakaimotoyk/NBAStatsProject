# ---------------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
nul

# ---------------------------------------------------------------------------
# Project-specific scratch
# ---------------------------------------------------------------------------
# Logs (pipeline runs land in logs/, plus stray .log files)
*.log
logs/

# Generated dashboard / prediction outputs
outputs/predictions_history/
outputs/*.csv
outputs/*.pkl  # rebuildable dataset caches (100MB+, regenerated from the DB in ~60s)

# Jupyter checkpoints
.ipynb_checkpoints/

# Local-only test outputs
tmp/
scratch/

# ---------------------------------------------------------------------------
# Transient experiment artifacts (regenerable; large)
# ---------------------------------------------------------------------------
# Per-experiment feature-CSV backups and ablation variants
nba_ml_features.csv.backup_*
nba_ml_features_no_e7.csv
# Model artifacts are NOT tracked in git — they live in the artifact store
# (S3 in prod, MODELS_ARTIFACT_DIR mirror in dev; see core/artifact_store.py).
# Training pushes them on save; prediction pulls them on demand;
# `python scripts/sync_models.py push|pull` does bulk transfers.
models/bundles/
models/*.joblib
models/*.pt
# Local artifact-store mirror used to test push/pull without AWS
.artifact_store_mirror/
# Smoke-test scratch outputs
outputs/*smoketest*.json

# Personal planning + learning notes (kept local, not part of the public repo)
docs/aws_deployment_plan.md
docker-learn/
*lab*

# Terraform (infra/)
# State can contain secrets (e.g. RDS password) and, with local state, is
# machine-specific — never commit it. Provider binaries are large + regenerable.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars often hold environment-specific or secret values; commit *.example only
*.tfvars
*.tfvars.json
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it pins provider
# versions (like package-lock.json) and SHOULD be committed.
# Claude's reference copy of the infra files (kept local during the hand-rebuild)
infra_reference/
# Throwaway bastion scaffolding — kept locally for reference, not in the repo
# (covers bastion.tf and the renamed bastion.tf.reference after teardown)
infra/bastion.tf*
# Throwaway one-off Fargate launcher (holds env-specific subnet/SG IDs + ad-hoc
# run args); regenerated as needed, not part of the repo.
infra/runtask.json
# Full local DB dump before migrating to RDS
infra/nba_data.sql

# Claude Code local settings - session-approved commands can embed sensitive strings
.claude/settings.local.json

# Datasets
outputs/*

# Experiment-loop frozen feature snapshot (regenerate via scripts/export_features_snapshot.py)
nba_ml_features_frozen.csv
